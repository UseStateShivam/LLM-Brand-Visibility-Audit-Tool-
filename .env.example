# Environment Configuration Example for LLM Brand Visibility Audit Tool
# Copy this file to .env and provide your actual API keys. Never commit .env with real credentials.

# LLM Provider Credentials
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default Models (can be overridden per audit)
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Data Storage Directory (relative to project root or absolute path)
DATA_DIR=data

# Network & Concurrency Defaults
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
RETRY_INITIAL_DELAY_SECONDS=1.0
RETRY_BACKOFF_FACTOR=2.0
MAX_CONCURRENT_REQUESTS=5

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
